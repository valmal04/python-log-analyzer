     1	import sys
     2	from collections import Counter
     3	
     4	THRESHOLD = 5
     5	
     6	if len(sys.argv) > 1:
     7	    log_file = sys.argv[1]
     8	else:
     9	    log_file = "sampleauth.txt"
    10	
    11	ip_counter = Counter()
    12	
    13	with open(log_file, "r") as f:
    14	    for line in f:
    15	        if "Failed" in line:
    16	            parts = line.split()
    17	            index = parts.index("from")
    18	            ip = parts[index + 1]
    19	            ip_counter[ip] += 1
    20	
    21	report_lines = print("Report tentativi di login falliti \n")
    22	
    23	for ip, count in ip_counter.most_common():
    24	    status = "SOSPETTO" if  count >= THRESHOLD else "normale"
    25	    report_lines.append(f"{ip}: {count} tentativi falliti -> {status}")
    26	
    27	report_text = "\n".join(report_lines)
    28	
    29	print(report_text)
    30	
    31	with open("report.txt", "w") as out:
    32	    out.write(report_text)
    33	
                                                                                                                                                           

